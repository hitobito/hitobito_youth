- title @group.to_s

- content_for(:filter, FilterNavigation::People.new(self, @group, @person_filter).to_s)

#main
  .pagination-bar.align-items-end
    = paginate @people

    .pagination-info.mb-3
      - if @person_filter.all_count > 0
        = t('people.list.number_of_people_shown', count: @people.total_count)
        - unless @person_filter.all_count == @people.total_count
          = muted(t('people.list.number_of_people_hidden',
                    count: @person_filter.all_count - @people.total_count))
      - else
        = ti(:no_list_entries)
    .ml-auto
      .d-flex.flex-column
        .fw-bold.text-dark= t('.legende')
        .d-flex.gap-3.ml-1
          .d-flex.gap-2.align-items-center
            %span.fs-4.pt-1 ■
            = t('.valid')
          .d-flex.gap-2.align-items-center.text-warning
            %span.fs-4.pt-1 ■
            = t('.valid_until_end_of_year')
          .d-flex.gap-2.align-items-center.muted
            %span.fs-4.pt-1 ■
            = t('.can_be_reactivated')

  - if @people.total_count > 0
    = table(@people, class: 'table table-striped') do |t|
      - t.col(t.sort_header(:name, Person.model_name.human)) do |person|
        %strong
          = link_to(person.to_s(:list),
                    group_person_path(@person_filter.multiple_groups ? person.default_group_id : @group, person))
      - t.col(t.sort_header(:qualification, Qualification.model_name.human(count: 2))) do |person|
        = joined_qualification_kind_labels(person)
      - t.col(Event::Application.model_name.human(count: 2)) do |person|
        = joined_event_participations(person)
      - t.col(t.sort_header(:birthday, Person.human_attribute_name(:birthday))) do |person|
        = format_attr(person, :birthday)

= paginate @people
